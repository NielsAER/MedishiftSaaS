# Database
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Session
SESSION_SECRET=change-me-to-a-strong-secret

# Neon Auth (OAuth2 / OIDC)
# Base URL for your Neon Auth/OpenID provider (e.g. https://auth.neon.example)
NEON_AUTH_URL=https://your-neon-auth.example
NEON_CLIENT_ID=your_client_id
NEON_CLIENT_SECRET=your_client_secret
# Redirect URI registered with your Neon provider. Example: https://your-app.example/api/callback
NEON_REDIRECT_URI=https://localhost:3000/api/callback
# Optional end session endpoint
NEON_ENDSESSION_URL=https://your-neon-auth.example/end-session

# Optional: override for apps that use a different variable name
# AUTH_REDIRECT_URI can be used if NEON_REDIRECT_URI is not set
